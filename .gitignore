# Perché: File Python compilati non servono su GitHub
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Perché: Ambiente virtuale è personale di ogni utente
venv/
env/
ENV/

# Perché: Jupyter crea cache che cambia sempre
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Perché: Audio files sono grandi (>100MB)
*.wav
*.mp3
*.flac
*.ogg
# Ma vogliamo tenere gli esempi piccoli
!examples/*.wav

# Perché: File del sistema operativo inutili
.DS_Store
Thumbs.db
desktop.ini

# Perché: Configurazioni dell'editor personali
.vscode/
.idea/
*.swp

# Perché: File di output temporanei
results/
outputs/
temp/
*.log

# Perché: Modelli grandi (>100MB)
*.pt
*.pth
*.ckpt
checkpoints/
