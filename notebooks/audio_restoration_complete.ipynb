import matplotlib.pyplot as plt
import librosa.display

print("\n" + "=" * 70)
print("📊 GENERATING VISUAL COMPARISON")
print("=" * 70)

if os.path.exists("test_original.wav") and os.path.exists("test_restored.wav"):
    # Load both audio files
    y_orig, sr = librosa.load("test_original.wav", sr=44100)
    y_rest, _ = librosa.load("test_restored.wav", sr=44100)
    
    # Limit to first 30 seconds for visualization
    max_samples = 30 * sr
    y_orig = y_orig[:max_samples]
    y_rest = y_rest[:max_samples]
    
    # Create figure with 2x2 subplots
    fig, axes = plt.subplots(2, 2, figsize=(16, 10))
    
    # Compute spectrograms (STFT magnitude in dB)
    D_orig = librosa.amplitude_to_db(np.abs(librosa.stft(y_orig)), ref=np.max)
    D_rest = librosa.amplitude_to_db(np.abs(librosa.stft(y_rest)), ref=np.max)
    
    # Plot original spectrogram
    img1 = librosa.display.specshow(
        D_orig, sr=sr, x_axis='time', y_axis='hz',
        ax=axes[0, 0], cmap='magma'
    )
    axes[0, 0].set_title(
        'ORIGINAL - Spectrogram (note noise and artifacts)', 
        fontsize=14, fontweight='bold', color='red'
    )
    axes[0, 0].set_ylim([0, 20000])
    plt.colorbar(img1, ax=axes[0, 0], format='%+2.0f dB')
    
    # Plot restored spectrogram
    img2 = librosa.display.specshow(
        D_rest, sr=sr, x_axis='time', y_axis='hz',
        ax=axes[0, 1], cmap='magma'
    )
    axes[0, 1].set_title(
        'RESTORED - Spectrogram (cleaner spectrum)', 
        fontsize=14, fontweight='bold', color='green'
    )
    axes[0, 1].set_ylim([0, 20000])
    plt.colorbar(img2, ax=axes[0, 1], format='%+2.0f dB')
    
    # Plot original waveform
    librosa.display.waveshow(y_orig, sr=sr, ax=axes[1, 0], color='red', alpha=0.7)
    axes[1, 0].set_title('ORIGINAL - Waveform', fontsize=14, fontweight='bold')
    axes[1, 0].set_xlabel('Time (s)')
    axes[1, 0].set_ylabel('Amplitude')
    axes[1, 0].grid(True, alpha=0.3)
    
    # Plot restored waveform
    librosa.display.waveshow(y_rest, sr=sr, ax=axes[1, 1], color='green', alpha=0.7)
    axes[1, 1].set_title('RESTORED - Waveform', fontsize=14, fontweight='bold')
    axes[1, 1].set_xlabel('Time (s)')
    axes[1, 1].set_ylabel('Amplitude')
    axes[1, 1].grid(True, alpha=0.3)
    
    # Save and display
    plt.tight_layout()
    plt.savefig('comparison_youtube.png', dpi=150, bbox_inches='tight')
    plt.show()
    
    print("✅ Spectrograms saved as: comparison_youtube.png")
    print("\n📊 Visual Analysis:")
    print("  🔴 ORIGINAL: Diffuse noise, possible distortion artifacts")
    print("  🟢 RESTORED: Cleaner spectrum, better definition")
    print("  → Compare the frequency content and noise floor reduction")

else:
    print("❌ Audio files not found for visualization!")


