# =============================================================================
# AUDIO RESTORER CLASS
# =============================================================================

class AggressiveAudioRestorer:
    """
    Intelligent audio restoration system with multi-stage processing.
    
    This class implements a 6-stage pipeline:
    1. Targeted denoising (removes unwanted vocals/noise)
    2. De-clipping (repairs distortion artifacts)
    3. Adaptive filtering (frequency-selective noise removal)
    4. Spectral subtraction (removes residual noise)
    5. Clarity enhancement (multi-band EQ)
    6. Final polish (normalization and dithering)
    
    Parameters
    ----------
    sample_rate : int
        Target sample rate in Hz (default: 44100)
    verbose : bool
        Enable detailed logging (default: True)
    
    Example
    -------
    >>> restorer = AggressiveAudioRestorer(sample_rate=44100)
    >>> restorer.restore('input.wav', 'output.wav')
    """
    
    def __init__(self, sample_rate=44100, verbose=True):
        self.sr = sample_rate
        self.verbose = verbose
    
    def log(self, message):
        """Print log message if verbose mode is enabled"""
        if self.verbose:
            print(message)
    
    def aggressive_denoise(self, audio):
        """
        Stage 1: Targeted Denoising
        
        Removes unwanted vocal artifacts while preserving instrumental content.
        Uses STFT-based analysis to identify and attenuate voice-dominated regions.
        
        The algorithm:
        1. Analyzes frequency spectrum (200-4000 Hz is typical voice range)
        2. Detects frames where vocal energy dominates
        3. Attenuates those frames by 75%
        4. Applies median filtering to remove residual clicks
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            Denoised audio signal
        """
        self.log("  [1/6] 🧹 Targeted denoising (anti-vocal artifacts)...")
        
        # Compute Short-Time Fourier Transform
        D = librosa.stft(audio, n_fft=2048, hop_length=512)
        magnitude, phase = np.abs(D), np.angle(D)
        
        # Define voice frequency band (200-4000 Hz)
        freqs = librosa.fft_frequencies(sr=self.sr, n_fft=2048)
        voice_band = (freqs > 200) & (freqs < 4000)
        
        # Detect voice-dominated regions
        voice_energy = np.median(magnitude[voice_band, :], axis=0)
        global_energy = np.median(magnitude, axis=0)
        voice_ratio = voice_energy / (global_energy + 1e-6)
        
        # Create attenuation mask
        # If voice ratio > 0.85, it's likely unwanted vocal artifact
        voice_mask = voice_ratio < 0.85
        magnitude[:, ~voice_mask] *= 0.25  # Attenuate by 75%
        
        # Reconstruct audio from modified STFT
        D_clean = magnitude * np.exp(1j * phase)
        audio_clean = librosa.istft(D_clean, length=len(audio))
        
        # Apply median filter to remove residual clicks/pops
        audio_clean = median_filter(audio_clean, size=5)
        audio_clean = np.clip(audio_clean, -1, 1)
        
        return audio_clean.astype(np.float32)
    
    def declip(self, audio):
        """
        Stage 2: De-clipping
        
        Repairs audio distortion caused by clipping (signal exceeding ±1.0).
        Uses interpolation to reconstruct clipped samples.
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            De-clipped audio signal
        """
        self.log("  [2/6] 🔧 Repairing clipping artifacts...")
        
        # Detect clipped samples
        clipped_pos = audio > 0.99
        clipped_neg = audio < -0.99
        
        # If no clipping detected, return original
        if not (clipped_pos.any() or clipped_neg.any()):
            return audio
        
        # Interpolate clipped samples using surrounding clean samples
        indices = np.arange(len(audio))
        clean_mask = ~(clipped_pos | clipped_neg)
        
        if clean_mask.sum() > 10:  # Need enough clean samples for interpolation
            audio_fixed = np.interp(
                indices, 
                indices[clean_mask], 
                audio[clean_mask]
            )
            return audio_fixed
        
        return audio
    
    def adaptive_filtering(self, audio):
        """
        Stage 3: Adaptive Filtering
        
        Applies frequency-selective filtering based on spectral analysis.
        Removes frequency bands that are likely noise rather than signal.
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            Filtered audio signal
        """
        self.log("  [3/6] 🎛️  Adaptive frequency filtering...")
        
        # Compute STFT
        D = librosa.stft(audio)
        magnitude, phase = np.abs(D), np.angle(D)
        
        # Estimate noise profile as median across time
        noise_profile = np.median(magnitude, axis=1, keepdims=True)
        
        # Create mask: keep frequencies above 1.5x noise level
        clean_mask = magnitude > (noise_profile * 1.5)
        magnitude_clean = magnitude * clean_mask
        
        # Reconstruct audio
        D_clean = magnitude_clean * np.exp(1j * phase)
        audio_clean = librosa.istft(D_clean, length=len(audio))
        
        return audio_clean
    
    def spectral_subtraction(self, audio):
        """
        Stage 4: Spectral Subtraction
        
        Advanced noise reduction technique that estimates and subtracts
        the noise spectrum from the signal.
        
        Algorithm:
        1. Estimate noise from quietest 10% of frames
        2. Subtract 2x noise profile from signal (aggressive)
        3. Apply floor to prevent negative values
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            Noise-reduced audio signal
        """
        self.log("  [4/6] 📉 Spectral subtraction...")
        
        # Compute STFT
        D = librosa.stft(audio, n_fft=2048, hop_length=512)
        magnitude = np.abs(D)
        phase = np.angle(D)
        
        # Find quiet frames (likely noise-only)
        rms = np.sqrt(np.mean(magnitude**2, axis=0))
        noise_threshold = np.percentile(rms, 10)
        noise_frames = magnitude[:, rms < noise_threshold]
        
        if noise_frames.shape[1] > 0:
            # Estimate noise profile
            noise_profile = np.mean(noise_frames, axis=1, keepdims=True)
            
            # Subtract 2x noise profile (aggressive oversubtraction)
            magnitude_clean = magnitude - 2.0 * noise_profile
            
            # Apply spectral floor to prevent negative values
            magnitude_clean = np.maximum(magnitude_clean, 0.01)
        else:
            magnitude_clean = magnitude
        
        # Reconstruct audio
        D_clean = magnitude_clean * np.exp(1j * phase)
        audio_clean = librosa.istft(D_clean, length=len(audio))
        
        return audio_clean
    
    def enhance_clarity(self, audio):
        """
        Stage 5: Clarity Enhancement
        
        Multi-band equalization to improve audio clarity and presence.
        Different frequency bands are weighted based on perceptual importance.
        
        Band weights:
        - Sub-bass (20-60 Hz): 0.2x (reduce rumble)
        - Bass (60-250 Hz): 0.5x (maintain foundation)
        - Mids (250-4000 Hz): 1.5x (enhance clarity)
        - Highs (4000-16000 Hz): 1.8x (add presence)
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            Enhanced audio signal
        """
        self.log("  [5/6] ✨ Multi-band clarity enhancement...")
        
        # Design bandpass filters for each band
        sos_sub = signal.butter(4, [20, 60], 'bandpass', fs=self.sr, output='sos')
        sub = signal.sosfilt(sos_sub, audio)
        
        sos_bass = signal.butter(4, [60, 250], 'bandpass', fs=self.sr, output='sos')
        bass = signal.sosfilt(sos_bass, audio)
        
        sos_mids = signal.butter(4, [250, 4000], 'bandpass', fs=self.sr, output='sos')
        mids = signal.sosfilt(sos_mids, audio)
        
        sos_highs = signal.butter(4, [4000, 16000], 'bandpass', fs=self.sr, output='sos')
        highs = signal.sosfilt(sos_highs, audio)
        
        # Weighted sum of bands
        enhanced = 0.2*sub + 0.5*bass + 1.5*mids + 1.8*highs
        
        # Normalize to prevent clipping
        enhanced = enhanced / np.max(np.abs(enhanced)) * 0.9
        
        return enhanced
    
    def final_polish(self, audio):
        """
        Stage 6: Final Polish
        
        Applies finishing touches:
        1. Soft clipping to prevent harsh distortion
        2. Peak normalization to -0.5 dB
        3. Triangular dithering to reduce quantization noise
        
        Parameters
        ----------
        audio : np.ndarray
            Input audio signal
        
        Returns
        -------
        np.ndarray
            Polished audio signal ready for output
        """
        self.log("  [6/6] 💎 Final polish (normalization & dithering)...")
        
        # Soft clipping using tanh (smooth saturation)
        audio = np.tanh(audio / 0.9) * 0.9
        
        # Peak normalization to -0.5 dB (0.944 amplitude)
        peak = np.max(np.abs(audio))
        if peak > 0:
            audio = audio * (0.944 / peak)
        
        # Add triangular dither to decorrelate quantization noise
        dither = np.random.triangular(-1, 0, 1, len(audio)) * 0.0001
        audio = audio + dither
        
        # Safety clip
        audio = np.clip(audio, -1.0, 1.0)
        
        return audio
    
    def restore(self, input_path, output_path):
        """
        Execute complete restoration pipeline
        
        Loads audio, applies all 6 processing stages, and saves result.
        
        Parameters
        ----------
        input_path : str
            Path to input audio file
        output_path : str
            Path to save restored audio file
        
        Returns
        -------
        np.ndarray
            Restored audio signal
        """
        self.log(f"\n🔥 AUDIO RESTORATION: {os.path.basename(input_path)}")
        self.log("=" * 70)
        
        # Load audio file as mono at target sample rate
        audio, sr = librosa.load(input_path, sr=self.sr, mono=True)
        self.log(f"Loaded: {len(audio)/sr:.2f}s @ {sr} Hz")
        
        # Apply complete restoration pipeline
        audio = self.aggressive_denoise(audio)
        audio = self.declip(audio)
        audio = self.adaptive_filtering(audio)
        audio = self.spectral_subtraction(audio)
        audio = self.enhance_clarity(audio)
        audio = self.final_polish(audio)
        
        # Save as 24-bit WAV
        sf.write(output_path, audio, self.sr, subtype='PCM_24')
        self.log(f"✅ Saved: {output_path}")
        self.log("=" * 70)
        
        return audio

print("✅ AggressiveAudioRestorer class ready!")


# =============================================================================
# YOUTUBE DOWNLOAD UTILITY
# =============================================================================

def download_youtube_audio(url, output_name="youtube_audio"):
    """
    Download and convert YouTube video to audio file
    
    Uses yt-dlp to download the best quality audio stream and converts
    it to WAV format at 44.1 kHz mono for processing.
    
    Parameters
    ----------
    url : str
        YouTube video URL (e.g., "https://youtu.be/VIDEO_ID")
    output_name : str
        Output filename without extension (default: "youtube_audio")
    
    Returns
    -------
    str or None
        Path to downloaded WAV file, or None if download failed
    
    Example
    -------
    >>> audio_file = download_youtube_audio("https://youtu.be/dQw4w9WgXcQ")
    >>> if audio_file:
    >>>     print(f"Downloaded: {audio_file}")
    """
    print(f"📥 Downloading from YouTube: {url}")
    
    # Configure yt-dlp options
    ydl_opts = {
        'format': 'bestaudio/best',  # Best audio quality
        'outtmpl': f'{output_name}.%(ext)s',  # Output template
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'wav',  # Convert to WAV
            'preferredquality': '192',  # Quality setting
        }],
        'postprocessor_args': [
            '-ar', '44100',  # Sample rate: 44.1 kHz
            '-ac', '1',      # Channels: mono
        ],
        'prefer_ffmpeg': True,
        'quiet': False,
    }
    
    try:
        # Download and extract audio
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            title = info.get('title', 'Unknown')
            print(f"✅ Successfully downloaded: '{title}'")
        
        return f"{output_name}.wav"
    
    except Exception as e:
        print(f"❌ Download failed: {e}")
        return None

print("✅ YouTube download function ready!")


